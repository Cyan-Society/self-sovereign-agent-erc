# Self-Owning NFT Configuration
# Copy this file to .env and fill in your values
#
# SETUP CHECKLIST:
# [ ] 1. Create a wallet for deployment (can use `cast wallet new`)
# [ ] 2. Fund the wallet with Base Sepolia ETH (see faucet links below)
# [ ] 3. Get a Basescan API key for contract verification
# [ ] 4. Copy this file to .env and fill in values

# ============================================================
# RPC ENDPOINTS
# ============================================================
# Base Sepolia (testnet) - free public RPC
BASE_SEPOLIA_RPC=https://REPLACE_ME_RPC_ENDPOINT

# Base Mainnet - for production (optional for now)
BASE_MAINNET_RPC=https://REPLACE_ME_RPC_ENDPOINT

# ============================================================
# DEPLOYMENT WALLET
# ============================================================
# Private key for deployment transactions
# NEVER commit this to git! The .gitignore should exclude .env
#
# To create a new wallet:
#   cast wallet new
#
# To get testnet ETH for Base Sepolia:
#   - https://www.alchemy.com/faucets/base-sepolia
#   - https://faucet.quicknode.com/base/sepolia
#   - https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
#
DEPLOYER_PRIVATE_KEY=0xREPLACE_ME_32_BYTE_HEX_PRIVATE_KEY

# ============================================================
# CONTRACT VERIFICATION
# ============================================================
# Basescan API key for verifying contracts
# Get one at: https://basescan.org/myapikey (requires account)
#
BASESCAN_API_KEY=REPLACE_ME

# ============================================================
# CANONICAL ADDRESSES (DO NOT CHANGE)
# ============================================================
# Official ERC-6551 Registry - same address on all EVM chains
ERC6551_REGISTRY=0xREPLACE_ME_CONTRACT_ADDRESS

# Tokenbound V3 Account Implementation on Base Sepolia
# Reference: https://docs.tokenbound.org/contracts/deployments
TOKENBOUND_ACCOUNT_V3=0xREPLACE_ME_CONTRACT_ADDRESS

# ============================================================
# DEPLOYED CONTRACTS (fill after deployment)
# ============================================================
# Address of deployed SelfSovereignAgentNFT contract
AGENT_CONTRACT_ADDRESS=0xREPLACE_ME_CONTRACT_ADDRESS

# Token ID of your agent (after minting)
AGENT_TOKEN_ID=REPLACE_ME

# ============================================================
# AGENT EXECUTOR KEY (for TEE/automated operations)
# ============================================================
# Private key that will be granted executor permissions
# In production, this would be held in a TEE
# For testing, you can generate a separate key
#
# To create:
#   cast wallet new
#
AGENT_EXECUTOR_PRIVATE_KEY=0xREPLACE_ME_32_BYTE_HEX_PRIVATE_KEY

# ============================================================
# LETTA CONFIGURATION
# ============================================================
# Letta server URL for state anchoring integration
LETTA_API_URL=https://REPLACE_ME_LETTA_SERVER_URL

# Agent ID in Letta (for state export)
LETTA_AGENT_ID=REPLACE_ME

# Password for authenticating to the self-hosted Letta server
LETTA_PASSWORD=REPLACE_ME
